                    "payListDetailCode": "CL690722000001",
                    "amount": 25000,
                    "refDetail01": null,
                    "refDetail02": null
                  },
                  {
                    "payListDetailCode": "CL690722000002",
                    "amount": 25000,
                    "refDetail01": null,
                    "refDetail02": null
                  }
                ]
              }
            }
          }
        }
      }
