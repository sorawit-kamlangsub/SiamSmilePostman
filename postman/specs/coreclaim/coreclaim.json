        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "totalNetPaidAmount": {
                    "type": "integer"
                  },
                  "receivingBankId": {
                    "type": "integer"
                  },
                  "receivingBankAccountNo": {
                    "type": "string"
                  },
                  "receivingBankName": {
                    "type": "string"
                  },
                  "receivingName": {
                    "type": "string"
                  },
                  "receivingPhoneNumber": {
                    "type": "string"
                  },
                  "referentTransactionId": {
                    "type": "string"
                  },
                  "claimPayListHeaderCreateDetailDTO": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "payListDetailCode": {
                          "type": "string"
                        },
                        "amount": {
                          "type": "integer"
                        },
                        "refDetail01": {
                          "nullable": true
                        },
                        "refDetail02": {
                          "nullable": true
                        }
                      }
                    }
                  }
                }
              },
              "example": {
                "totalNetPaidAmount": 50000,
                "receivingBankId": 3,
                "receivingBankAccountNo": "{{ACC_NO}}",
                "receivingBankName": "ธนาคารกรุงไทย",
                "receivingName": "{{ACC_NAME}}",
